# Copy this file to .env (same folder). The only line you MUST change is DB_PASSWORD.

# Name shown in the header and page titles
SITE_NAME=Concert Tickets

# Signs login cookies. Leave blank and the site makes a secure random one for you.
# (Or generate your own: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# SQL Server (the learn-databases container). docker-compose.yml overrides DB_HOST to
# "mssql" inside Docker; "localhost" is for running the site with run.bat.
# Leave DB_HOST out entirely to use a local SQLite file instead.
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
# Set this to the MSSQL_SA_PASSWORD value in learn-databases/docker-compose.yaml
DB_PASSWORD=change-me
DB_NAME=concert_tickets

# Or give a full SQLAlchemy URL instead of the DB_* lines:
# DATABASE_URL=mssql+pymssql://user:password@host:1433/concert_tickets
