# Copy this file to .env and edit.

# Name shown in the header and page titles
SITE_NAME=Concert Tickets

# Signs login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQL Server (the learn-databases container). Leave DB_HOST out to use a local
# SQLite file instead. docker-compose.yml overrides DB_HOST to "mssql" inside Docker;
# "localhost" is for running the site directly on this PC with run.bat.
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=SU2orange!
DB_NAME=concert_tickets

# Or give a full SQLAlchemy URL instead of the DB_* lines:
# DATABASE_URL=mssql+pymssql://user:password@host:1433/concert_tickets
