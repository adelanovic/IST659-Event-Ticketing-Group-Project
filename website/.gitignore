# ---- Secrets: never commit ----------------------------------------------------
# Real settings live in .env; .env.example is the template and IS committed.
.env
.env.*
!.env.example
.secret_key

# ---- Python and tools ---------------------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/

# ---- Local data (may hold real accounts) ------------------------------------------------
*.db
*.sqlite3
